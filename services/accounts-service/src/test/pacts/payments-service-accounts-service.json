{
  "consumer": {
    "name": "payments-service"
  },
  "interactions": [
    {
      "description": "a debit of 200.00 against account 1, which exceeds its balance",
      "providerStates": [
        {
          "name": "account 1 exists with balance 50.00"
        }
      ],
      "request": {
        "body": {
          "amount": 200.0,
          "reason": "Payment to NL39RABO0300065264",
          "type": "DEBIT"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.amount": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            },
            "$.reason": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "method": "POST",
        "path": "/api/accounts/1/balance-mutations"
      },
      "response": {
        "body": {
          "error": "Insufficient funds"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.error": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 409
      }
    },
