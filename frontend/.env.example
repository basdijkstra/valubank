# Base URL for the Accounts Service (login, customers, accounts, interest rates).
# Defaults to http://localhost:8081 in the app if this is not set.
VITE_ACCOUNTS_API_URL=http://localhost:8081

# Base URL for the Payments Service (create payment, payment history).
# Defaults to http://localhost:8082 in the app if this is not set.
VITE_PAYMENTS_API_URL=http://localhost:8082
