{
  "permissions": {
    "deny": [
      "Read(**/.git/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/**)",
      "Read(~/.npmrc)",
      "Read(~/.gitconfig)",
      "Read(~/.git-credentials)",
      "Read(//etc/**)",
      "Read(//proc/**)"
    ]
  }
}
